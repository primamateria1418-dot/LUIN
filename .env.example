# LUIN Environment Configuration
# Copy to .env and fill in your values

# --- Core ---
APP_NAME=LUIN Executive Marketing Engine
APP_VERSION=2.0.0
DEBUG=false

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Database ---
DATABASE_URL=postgresql+asyncpg://luin:luin_password@db:5432/luin

# --- Groq ---
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_stripe_price
STRIPE_SUCCESS_URL=https://luin.cc/billing/success
STRIPE_CANCEL_URL=https://luin.cc/billing/cancel

# --- Tahuti / Hermes ---
TAHUTI_GATEWAY_URL=http://localhost:18789
TAHUTI_API_KEY=your_tahuti_key

# --- AI Services ---
TAVILY_API_KEY=your_tavily_key
COMFYUI_URL=http://host.docker.internal:8188
N8N_WEBHOOK_URL=http://localhost:5678/webhook/luin

# --- External APIs ---
POSTEVERYWHERE_API_KEY=your_posteverywhere_key
APOLLO_API_KEY=your_apollo_key

# --- Security ---
SECRET_KEY=luin-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Email ---
WHITELISTED_DOMAINS=gmail.com,yahoo.com,hotmail.com

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://luin.cc
